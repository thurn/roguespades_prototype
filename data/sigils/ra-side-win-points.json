      "ua-side-raise",
      "ua-aces-untrumpable",
      "ua-diamonds-untrumpable",
      "ra-rainbow-first-x"
    ],
    "cluster": "A",
    "draftText": "+30 contract points when your team wins a trick with a card other than [♠]",
    "hooks": "none",
    "critic": {
      "verdict": "keep",
      "concerns": "Fires on most tricks, so it plays close to a flat bonus; tension against ruffing is real but mild.",
      "elegance": 3
    }
  },
