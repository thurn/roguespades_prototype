  "design": {
    "decision": "Keep length in a side suit and cash its low cards late after the honors fall, instead of drawing trumps first; your team's honors can still be trumped, so lead them early and save low cards for the end.",
    "opponent": "Shows up when an opponent's ruff fails to beat a [7]; opponents switch from trumping to holding high cards of the team's long suits.",
    "rationale": "Turns the Low Cards plan, winning through length after the honors are gone, into a reliable line of play. Its standalone value is protecting most of the hand from ruffs. It is distinct from the uncommon [A] and [♦] versions because it reverses the usual priority between honors and low cards.",
    "partners": [
      "seed-low-four",
      "uc-low-three-x",
      "cc-low-last-mult",
      "ua-side-win-mult"
    ],
    "cluster": "C",
    "draftText": "Your team's [2]s through [10]s can't be trumped",
    "hooks": "none",
    "critic": {
      "verdict": "keep",
      "concerns": "A fifth member of the untrumpable family (ua-aces-, ua-diamonds-, ra-team-, rb-side-); the shield only matters when a low card is winning its suit, which is late and rare.",
      "elegance": 3
    }
  },
