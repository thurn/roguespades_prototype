    "draftText": "+2 contract multiplier for each trick in your team's contract",
    "hooks": "none",
    "critic": {
      "verdict": "keep",
      "concerns": "Same signature as cc-mult-per-trick, differing only in amount; merge them and let the amount sweep decide.",
      "elegance": 5
    }
  },
