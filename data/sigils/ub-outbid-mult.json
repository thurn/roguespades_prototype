  "design": {
    "decision": "Bid order matters: the later bidder can stretch one trick past the opponents' contract.",
    "opponent": "Revealed after bidding; opponents can bid up to deny it, raising their own set risk.",
    "rationale": "Bid tension that is relative rather than absolute, so it stays tense in round 1 and round 8 alike and makes both teams' bids interact.",
    "partners": [
      "ub-bid8-xmult",
      "cb-contract-mult",
      "ub-become-four-spades"
    ],
    "cluster": "B",
    "draftText": "+20 contract multiplier when your team bids more than the opponents",
    "hooks": "A bid trigger that compares the team's contract with the opponents' contract after bidding (bid { vs: opponents }: fires when your contract is larger).",
    "critic": {
      "verdict": "keep",
      "concerns": "Favors the later bidder by seat order, but it is a good interactive bid hook that opponents can answer by bidding.",
      "elegance": 4
    }
  },
