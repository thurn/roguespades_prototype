  "design": {
    "decision": "Lead [♦] honors to cash them, and once your team is void, trump [♦] leads instead of discarding, which pulls the Suits and Spades plans together.",
    "opponent": "Shown on the first such win; opponents stop leading [♦] and duck [♦] tricks they would otherwise contest.",
    "rationale": "Uncommon and common versions pay flat amounts; at rare this compounds per event. The led-suit filter rewards both cashing [♦] and ruffing it, so the [♦] line has two ways to score and is not killed by voids.",
    "partners": [
      "ua-diamonds-untrumpable",
      "ca-diamond-led-win",
      "ra-clubs-to-diamonds",
      "e-trump-mult"
    ],
    "cluster": "A",
    "draftText": "×1.3 contract multiplier when your team wins a trick led with [♦]",
    "hooks": "none",
    "critic": {
      "verdict": "keep",
      "concerns": "Per-event compounding ×mult is hard to track; otherwise a clean step up from ua-diamond-led-win-mult and ca-diamond-led-win.",
      "elegance": 4
    }
  },
