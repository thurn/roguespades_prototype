  "design": {
    "decision": "Bid nil on borderline hands when the partner can still carry a contract, since the points need the contract made.",
    "opponent": "Revealed at the nil bid; opponents can attack either the nil or the partner's contract.",
    "rationale": "Rewards the bid rather than the outcome, but as contract points it still needs the partner's contract, so it rewards the whole team plan rather than only the nil.",
    "partners": [
      "cc-swap-five",
      "seed-nil-bid-mult",
      "cc-nil-contract-trick",
      "seed-contract-points"
    ],
    "cluster": "C",
    "draftText": "+80 contract points when your team bids nil",
    "hooks": "none",
    "critic": {
      "verdict": "keep",
      "concerns": "Pays even when the nil fails, as long as the partner makes the contract, so it may reward throwaway nils; the BidHigh tag is weak.",
      "elegance": 3
    }
  },
