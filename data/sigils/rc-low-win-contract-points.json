  "design": {
    "decision": "Win with low cards (ruff with a low [♠] instead of a high one, and keep length for late tricks) and bid higher, since every low win is worth more with a bigger contract and all of it is lost on a set.",
    "opponent": "Revealed on the first low win; opponents overruff low trumps and lead honors to drain the team's low cards.",
    "rationale": "Low Cards has no payoff that scales with contract size; this adds bid tension, since contract points vanish on a set. Rare pays +50 or more per event at a typical contract. [2]-[9] matches uc-low-win-mult, so the two stack.",
    "partners": [
      "uc-low-win-mult",
      "ua-low-become-spades",
      "uc-trump-freely",
      "rc-low-untrumpable"
    ],
