    "draftText": "+10 contract points for each trick in your team's contract when your team wins a trick with a [2] through [9]",
    "hooks": "none",
    "critic": {
      "verdict": "keep",
      "concerns": "Long sentence with two numbers, a range, and contract scaling; the per-contract-trick points pattern is now in many sigils.",
      "elegance": 2
    }
