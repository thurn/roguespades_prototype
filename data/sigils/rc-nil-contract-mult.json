  "design": {
    "decision": "When one partner bids nil, the other bids as high as they dare, because a bigger contract makes the nil bonus bigger; if the contract is set while the nil is made, the bonus still multiplies a negative base.",
    "opponent": "Visible at bidding: a nil next to a big bid is a signal; opponents push to bust the nil or to set the big contract, and either one hurts.",
    "rationale": "Ties Nil to bid size, which the pool needs, and turns the nil partner's bid into a real decision instead of a safe minimum. Its trigger differs from uc-nil-contract-mult (made nil rather than bid nil), so the risk is paid off only by success.",
    "partners": [
      "cc-nil-made-mult",
      "uc-nil-contract-mult",
      "cb-contract-mult",
      "rc-honor-free"
    ],
    "cluster": "C",
    "draftText": "+3 contract multiplier for each trick in your team's contract if your team makes a nil",
    "hooks": "none",
    "critic": {
      "verdict": "keep",
      "concerns": "Differs from uc-nil-contract-mult only in the trigger (made versus bid nil); fine.",
      "elegance": 3
    }
  },
