    "draftText": "×2 contract multiplier when your team bids more than the opponents",
    "hooks": "none",
    "critic": {
      "verdict": "keep",
      "concerns": "Clean and interactive; the last bidder has an information edge, which is ordinary Spades and visible to everyone.",
      "elegance": 5
    }
  },
