      "cb-consecutive-mult",
      "seed-contract-points",
      "ub-four-row-xmult"
    ],
    "cluster": "B",
    "draftText": "+5 contract points for each trick in your team's contract when your team wins consecutive tricks",
    "hooks": "none",
    "critic": {
      "verdict": "keep",
      "concerns": "Per-event payout times contract size (45 per back-to-back win at a 9-bid) is hard to track at the table.",
      "elegance": 2
    }
  },
