  "design": {
    "decision": "Every trick bid compounds the round: 7 gives ×1.41, 10 gives ×1.63, and a set is multiplied too.",
    "opponent": "Revealed at the first scored round; opponents defend hard against big contracts.",
    "rationale": "The ×mult form of the strongest common (cb-contract-mult). Scaling applies on sets too, so it is bid tension in its simplest form.",
    "partners": [
      "cb-contract-mult",
      "ub-become-four-spades",
      "ub-low-to-aces"
    ],
    "cluster": "B",
    "draftText": "×1.05 contract multiplier for each trick in your team's contract",
    "hooks": "per: contractTrick on an xmult should compound (amount to the power of the contract) instead of multiplying the amount by the contract; today the kernel computes amount × contract, which is unprintable for ×mults.",
    "critic": {
      "verdict": "keep",
      "concerns": "×1.05 compounded per contract trick can't be totalled at the table; kept cb-contract-mult does the same bid-tension job readably.",
      "elegance": 2
    }
  },
