  "design": {
    "decision": "Keep side [A]s longer instead of cashing them before opponents void the suit, and bid every [A] as a sure trick.",
    "opponent": "Revealed the first time a trump fails to beat an [A]. Opponents then stop wasting trumps on [A]s and must win elsewhere.",
    "rationale": "Changing who wins tricks is the other large enabler lever the brief names. This answers the stated Ranks threat that [A]s get trumped once a suit runs out. It is new hook 1 of 4, and the one general mechanism serves several candidates.",
    "partners": [
      "seed-ace-win",
      "ca-ace-win-two-mult",
      "ua-ace-win-contract",
      "ua-twos-become-aces",
      "seed-rainbow-mult"
    ],
    "cluster": "A",
    "draftText": "Your team's [A]s can't be trumped",
    "hooks": "Trick resolution: a card your team plays that matches a filter and is of the led suit beats any [♠] played to that trick (it still loses to a higher card of the led suit). Effect type untrumpable with a from filter.",
    "critic": {
      "verdict": "keep",
      "concerns": "Removes the main defence against [A]s with a new rule exception; clear once revealed, but the first reveal is a gotcha for opponents.",
      "elegance": 4
    }
  },
