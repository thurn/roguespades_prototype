  },
  "design": {
    "decision": "Treat each [2] as a winner of its suit and bid it; if a partner bids nil, keep that partner's [2]s away from tricks they would now win.",
    "opponent": "Revealed the first time a [2] wins; opponents stop leading suits where the team holds a [2] and avoid playing honors under it.",
    "rationale": "It changes the actual winner of a trick without renaming the card, so it is not a rename-only effect. A [2] stays a [2] for every check, which gives standalone strength (about two extra winners per team), powers [2] payoffs, and creates a real tension with nil.",
    "partners": [
      "cc-two-win-mult",
      "seed-two-win",
      "uc-two-grow-points",
      "cc-two-hold-mult",
      "seed-rainbow-first"
    ],
    "cluster": "C",
    "draftText": "Your team's [2]s beat every other card of their suit",
    "hooks": "A trick-strength override: cards matching a filter, when played by your team, rank above the [A] of their own suit, and still lose to trumps unless they are [♠]s. As a general hook, `beats` takes a card filter and is resolved in the kernel's trick comparison.",
    "critic": {
      "verdict": "keep",
      "concerns": "With uc-low-to-twos every [3]-[6] beats its suit; 'beats the [A]' is a new rule players must learn.",
      "elegance": 4
    }
  },
