  "design": {
    "decision": "Every time you have the lead, choose between cashing a winner and leading low for ×1.2 while giving the lead to the opponents; it rewards keeping low cards and winning in order to lead them.",
    "opponent": "Obvious after a few leads; opponents can duck low leads cheaply but must decide whether to take the lead back.",
    "rationale": "Lead triggers measured very strongly (e-lead-rank-2-xmult +19.9 at common), and leading low is real tension in Spades because it gives up control and the opponents can take the trick. A repeated ×mult at a small factor is the rare budget's 'broad' shape and is distinct from the uncommon milestone uc-low-lead-three-x.",
    "partners": [
      "uc-low-lead-mult",
      "uc-low-lead-three-x",
      "uc-low-lead-nil",
      "rc-low-beats"
    ],
    "cluster": "C",
    "draftText": "×1.2 contract multiplier when your team leads a [2] through [6]",
    "hooks": "none",
    "critic": {
      "verdict": "keep",
      "concerns": "Leading low is often the natural play anyway, so it may fire on autopilot; per-event compounding is hard to track.",
      "elegance": 3
    }
  },
