  "design": {
    "decision": "The team decides every trick whether to follow or discard, so it can duck to protect a nil or an exact contract, keep honors, or empty a suit early to trump it later.",
    "opponent": "Opponents can't force the owner to overtake or to spend honors, but the owner still can't trump at will, so long [♠]s keep their value against it.",
    "rationale": "A rule-changing legendary that loosens following suit for every build (Nil, Exact, Suits voids, Spades ruffs) without favoring any one, unlike a flat multiplier.",
    "partners": [
      "uc-trump-freely",
      "uc-low-discard",
      "rb-honors-free",
      "seed-exact-mult",
      "seed-nil-points"
    ],
