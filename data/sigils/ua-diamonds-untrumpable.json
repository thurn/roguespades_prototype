  "design": {
    "decision": "Run long [♦]s and lead [♦] repeatedly: any [♦] that is the highest [♦] on the trick wins, so length turns into tricks.",
    "opponent": "Voiding [♦] no longer works as a defense, so opponents must keep high [♦]s or concede the suit.",
    "rationale": "The stated threat to the Suits length line is being trumped. This removes that threat and makes [♦] length worth bidding on its own, with [♦] first as the brief asks. It is new hook 2 of 4 and reuses hook 1.",
    "partners": [
      "ca-diamond-hold-eight",
      "ua-diamond-hold-mult",
      "ua-diamond-lead-three-x",
      "ca-diamond-led-win",
      "ua-diamond-two-x"
    ],
    "cluster": "A",
    "draftText": "Your team's [♦]s can't be trumped",
    "hooks": "Same as ua-aces-untrumpable: untrumpable with a from filter.",
    "critic": {
      "verdict": "keep",
      "concerns": "A strong rule exception that removes voiding as a defence; opponents can respond only after the first reveal.",
      "elegance": 4
    }
  },
