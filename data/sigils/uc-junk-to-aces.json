  "design": {
    "decision": "Bid one or two tricks higher, and decide which new [A] to cash first and which to hold as a late entry.",
    "opponent": "Revealed at Opening; opponents may find their own [A] duplicated, so their sure winners are no longer sure and they must count aces again.",
    "rationale": "cb-become-ace (+3.0) showed that extra aces help, but random selection often wastes the change on a card that was already a winner. Drawing only from [2]-[6] guarantees that two losers become winners. The uncommon price buys a better source of cards, not a rider, and the count (Two) stays tunable.",
    "partners": [
      "ca-ace-win-two-mult",
      "ca-three-aces-mult",
      "seed-ace-three",
      "cb-become-ace",
      "cb-bid7-mult"
    ],
    "cluster": "C",
    "draftText": "Opening: Two [2]s through [6]s your team holds become [A]s",
    "hooks": "none",
    "critic": {
      "verdict": "keep",
      "concerns": "Near-duplicate of batch ub-low-to-aces; the design note's 'revealed at Opening' is wrong, it reveals when a changed [A] wins.",
      "elegance": 4
    }
  },
