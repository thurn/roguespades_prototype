  "design": {
    "decision": "The covering partner plays to win every trick it can, overtaking the nil bidder's cards, and the team bids nil when one partner is strong.",
    "opponent": "Visible as the nil score grows; opponents must choose between busting the nil and stopping the partner's wins.",
    "rationale": "It rewards the partner's half of the nil plan, which no Nil payoff does yet. Tricks a nil bidder wins never count, so the rule needs no exception. It pays only on a made nil, so the risk stays.",
    "partners": [
      "seed-nil-bid-mult",
      "cc-nil-made-mult",
      "uc-low-discard",
      "uc-nil-contract-mult"
    ],
