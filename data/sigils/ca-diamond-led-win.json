    "draftText": "+20 contract points when your team wins a trick led with [♦]",
    "hooks": "Win trigger with an optional filter on the led card (\"led\") instead of the winning card.",
    "critic": {
      "verdict": "keep",
      "concerns": "New led-card filter is clean and rewards both the honor line and the void line; opponents can see it and stop leading [♦].",
