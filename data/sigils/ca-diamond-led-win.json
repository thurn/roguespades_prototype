  "design": {
    "decision": "Win [♦] tricks either with top [♦]s or by staying void and trumping; it shapes when to keep or shed [♦]s.",
    "opponent": "Revealed on the first such win; opponents avoid leading [♦] into a void.",
    "rationale": "Both lines of a [♦] plan score here (honors win the suit, a void trumps it), which fixes the length line's main threat of [♦]s being trumped.",
    "partners": [
      "ca-diamond-become-from-clubs",
      "seed-trump-points",
      "seed-diamond-hold"
    ],
    "cluster": "A",
    "draftText": "+20 contract points when your team wins a trick led with [♦]",
    "hooks": "Win trigger with an optional filter on the led card (\"led\") instead of the winning card.",
    "critic": {
      "verdict": "keep",
      "concerns": "New led-card filter is clean and rewards both the honor line and the void line; opponents can see it and stop leading [♦].",
      "elegance": 5
    }
  },
