  },
  "design": {
    "decision": "Bid low and duck: every overtrick your team takes is a trick the opponents don't, so make exactly your contract and give away the rest; it also multiplies a made nil.",
    "opponent": "Revealed on the first trick they win; opponents may decline cheap tricks or try to push extra tricks onto your team.",
    "rationale": "Exact lacks a rare that isn't just a bigger amount on an existing uncommon; this pays the Exact idea (no overtricks) a little at a time instead of all at once, pairs with Nil, and applies on sets so low bids still carry risk.",
    "partners": [
      "cc-small-contract-mult",
      "seed-exact-mult",
      "cc-nil-made-mult",
      "seed-nil-bid-mult"
    ],
    "cluster": "B",
    "draftText": "+2 contract multiplier when the opponents win a trick",
    "hooks": "New trigger scope `whose: opponents` on win triggers: counts tricks any player on the opposing team wins, as a general mirror of every win trigger.",
    "critic": {
      "verdict": "keep",
      "concerns": "Opponents can't avoid winning the tricks they need, so their only response is ducking overtricks; in practice it is close to a flat +mult that rewards low bids.",
      "elegance": 4
    }
  },
  "status": "kept",
